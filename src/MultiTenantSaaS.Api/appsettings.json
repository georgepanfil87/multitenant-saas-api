{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MultiTenancy": {
    "HeaderName": "X-Tenant",
    "EnableHeaderStrategy": true,
    "EnableSubdomainStrategy": false,
    "BaseDomain": null,
    "SkipPaths": [
      "/health",
      "/swagger"
    ]
  }
}