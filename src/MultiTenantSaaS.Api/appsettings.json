{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MultiTenancy": {
    "HeaderName": "X-Tenant",
    "EnableHeaderStrategy": true,
    "EnableSubdomainStrategy": false,
    "BaseDomain": null,
    "SkipPaths": [
      "/health",
      "/swagger"
    ]
  },
  "Jwt": {
    "Issuer": "MultiTenantSaaS",
    "Audience": "MultiTenantSaaS.Clients",
    "AccessTokenMinutes": 60
  },
  "RateLimiting": {
    "FreePerMinute": 60,
    "ProPerMinute": 300,
    "EnterprisePerMinute": 1000,
    "AnonymousPerMinute": 30,
    "RegistrationsPerHour": 5,
    "SkipPaths": [
      "/health",
      "/swagger"
    ]
  }
}