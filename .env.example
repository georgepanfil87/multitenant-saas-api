# Copy this file to `.env` and change the values.
# `.env` is gitignored and never reaches the repository.

# --- PostgreSQL ---
POSTGRES_DB=multitenant_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=schimba-aceasta-parola
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# JWT signing key, at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=schimba-aceasta-cheie-cu-minim-32-de-caractere
JWT_ISSUER=MultiTenantSaaS
JWT_AUDIENCE=MultiTenantSaaS.Clients

# --- pgAdmin (optional: docker compose --profile tools up) ---
PGADMIN_EMAIL=admin@exemplu.ro
PGADMIN_PASSWORD=schimba-aceasta-parola
PGADMIN_PORT=5050
